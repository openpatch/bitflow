{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A Worker, not a browser: `worker-configuration.d.ts` (generated by
    // `pnpm --filter bitflow-party types`) declares the globals and the `Env`
    // the Durable Object binding produces. DOM is dropped from `lib` because
    // the two disagree about half of them — `WebSocket` above all.
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src", "worker-configuration.d.ts"]
}
