{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitflow-party",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-06",

  // The room. The binding name is what the URL is routed by:
  // `routePartykitRequest` kebab-cases it, so `Session` serves
  // `/parties/session/<room code>` and the client asks for `party: "session"`.
  // PartyServer has no default party — renaming this binding breaks every
  // client until `platforms/web/src/session.ts` is renamed with it.
  "durable_objects": {
    "bindings": [{ "name": "Session", "class_name": "Session" }]
  },

  // SQLite-backed, which is the only kind a new Durable Object may be. The tag
  // is history: never edit or remove v1, add a v2 beside it.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],

  // 1999 is what PartyKit's dev server used, and what
  // `platforms/web/src/session.ts` still falls back to. Keeping it means
  // `pnpm --filter web dev` needs no environment variable to find a local
  // session server.
  "dev": { "port": 1999 },

  "observability": { "enabled": true }
}
