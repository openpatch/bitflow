{
  "name": "@bitflow/web-component",
  "version": "0.0.0",
  "author": "Mike Barkmin",
  "description": "bitflow as framework-agnostic custom elements.",
  "homepage": "https://github.com/openpatch/bitflow#readme",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "import": "./dist/flow.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpatch/bitflow.git",
    "directory": "packages/web-component"
  },
  "bugs": {
    "url": "https://github.com/openpatch/bitflow/issues"
  },
  "scripts": {
    "version": "pnpm build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rimraf dist && vite build && pnpm build:types",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@bitflow/bitflow": "workspace:*",
    "@bitflow/core": "workspace:*",
    "@bitflow/element": "workspace:*",
    "@bitflow/end-tries": "workspace:*",
    "@bitflow/input-markdown": "workspace:*",
    "@bitflow/report": "workspace:*",
    "@bitflow/start-simple": "workspace:*",
    "@bitflow/task-boolean-logic": "workspace:*",
    "@bitflow/task-choice": "workspace:*",
    "@bitflow/task-code-trace": "workspace:*",
    "@bitflow/task-crossword": "workspace:*",
    "@bitflow/task-drag-drop": "workspace:*",
    "@bitflow/task-fill-in-the-blank": "workspace:*",
    "@bitflow/task-find-hotspots": "workspace:*",
    "@bitflow/task-free-text": "workspace:*",
    "@bitflow/task-graph-path": "workspace:*",
    "@bitflow/task-highlighting": "workspace:*",
    "@bitflow/task-image-annotation": "workspace:*",
    "@bitflow/task-input": "workspace:*",
    "@bitflow/task-keyboard-speed": "workspace:*",
    "@bitflow/task-matching": "workspace:*",
    "@bitflow/task-math": "workspace:*",
    "@bitflow/task-mouse-accuracy": "workspace:*",
    "@bitflow/task-number-representation": "workspace:*",
    "@bitflow/task-numeric": "workspace:*",
    "@bitflow/task-ordering": "workspace:*",
    "@bitflow/task-parsons": "workspace:*",
    "@bitflow/task-word-search": "workspace:*",
    "@bitflow/task-yes-no": "workspace:*",
    "@bitflow/title-simple": "workspace:*",
    "@r2wc/react-to-web-component": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
