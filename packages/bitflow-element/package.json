{
  "name": "@bitflow/element",
  "version": "0.0.0",
  "author": "Mike Barkmin",
  "description": "Renders a registered bit and wraps it as a standalone custom element. Shared by every bit package and by the flow runtime.",
  "homepage": "https://github.com/openpatch/bitflow#readme",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpatch/bitflow.git",
    "directory": "packages/bitflow-element"
  },
  "bugs": {
    "url": "https://github.com/openpatch/bitflow/issues"
  },
  "scripts": {
    "version": "pnpm build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rimraf dist && vite build && pnpm build:types",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@bitflow/core": "workspace:*",
    "@r2wc/react-to-web-component": "^2.1.1",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
